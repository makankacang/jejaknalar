{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jejaknalar.local/contracts/story-bundle.schema.json",
  "title": "JejakNalar Story Bundle Draft v0.1",
  "description": "Proposal-only public story/gameplay content paired with QuestV1 by quest_version_id. Not a final API or runtime-playability guarantee.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_schema_version",
    "quest_version_id",
    "source_document_versions",
    "registry_version",
    "world_preset",
    "start_room_id",
    "title",
    "opening",
    "missions",
    "dialogues",
    "tasks",
    "evidence",
    "endings"
  ],
  "properties": {
    "bundle_schema_version": { "type": "string", "const": "0.1-draft" },
    "quest_version_id": { "type": "string", "pattern": "^QV-[A-Z0-9-]+$" },
    "source_document_versions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceDocumentVersion" }
    },
    "registry_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "world_preset": { "type": "string", "enum": ["school", "city"] },
    "start_room_id": { "$ref": "#/$defs/nonEmptyId" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "opening": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "learning_context": { "$ref": "#/$defs/learningContext" },
    "missions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mission" }
    },
    "dialogues": {
      "type": "array",
      "items": { "$ref": "#/$defs/dialogue" }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "hints": {
      "type": "array",
      "items": { "$ref": "#/$defs/hint" }
    },
    "feedback": {
      "type": "array",
      "items": { "$ref": "#/$defs/feedback" }
    },
    "endings": { "$ref": "#/$defs/endings" }
  },
  "$defs": {
    "nonEmptyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "objectiveId": { "type": "string", "pattern": "^LO-[A-Z0-9-]+$" },
    "sourceDocumentVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "text_version"],
      "properties": {
        "document_id": { "$ref": "#/$defs/nonEmptyId" },
        "text_version": { "$ref": "#/$defs/nonEmptyId" }
      }
    },
    "learningContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grade": { "type": "integer", "enum": [7, 8, 9] },
        "subject": { "type": "string", "minLength": 1, "maxLength": 120 },
        "topic": { "type": "string", "minLength": 1, "maxLength": 240 },
        "curriculum": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "sourceLocator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "page"],
          "properties": {
            "kind": { "const": "pdf_page" },
            "page": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "paragraph_index"],
          "properties": {
            "kind": { "const": "docx_paragraph" },
            "paragraph_index": { "type": "integer", "minimum": 1 },
            "section": { "type": "string", "minLength": 1, "maxLength": 240 }
          }
        }
      ]
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "text_version", "source_map_id", "locator", "excerpt"],
      "properties": {
        "document_id": { "$ref": "#/$defs/nonEmptyId" },
        "text_version": { "$ref": "#/$defs/nonEmptyId" },
        "source_map_id": { "$ref": "#/$defs/nonEmptyId" },
        "locator": { "$ref": "#/$defs/sourceLocator" },
        "excerpt": { "type": "string", "minLength": 8, "maxLength": 1000 }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_id", "objective_ids", "required", "room_id", "prerequisites", "activity_ids"],
      "properties": {
        "mission_id": { "$ref": "#/$defs/nonEmptyId" },
        "objective_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/objectiveId" } },
        "required": { "type": "boolean" },
        "room_id": { "$ref": "#/$defs/nonEmptyId" },
        "prerequisites": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyId" } },
        "activity_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyId" } }
      }
    },
    "dialogueChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choice_id", "label"],
      "properties": {
        "choice_id": { "$ref": "#/$defs/nonEmptyId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 240 },
        "next_node_id": { "$ref": "#/$defs/nonEmptyId" },
        "unlock_mission_id": { "$ref": "#/$defs/nonEmptyId" }
      },
      "anyOf": [
        { "required": ["next_node_id"] },
        { "required": ["unlock_mission_id"] }
      ]
    },
    "dialogueNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "text", "choices"],
      "properties": {
        "node_id": { "$ref": "#/$defs/nonEmptyId" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "objective_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/objectiveId" } },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" } },
        "choices": { "type": "array", "items": { "$ref": "#/$defs/dialogueChoice" } }
      }
    },
    "dialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npc_id", "room_id", "start_node_id", "nodes"],
      "properties": {
        "npc_id": { "$ref": "#/$defs/nonEmptyId" },
        "room_id": { "$ref": "#/$defs/nonEmptyId" },
        "start_node_id": { "$ref": "#/$defs/nonEmptyId" },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dialogueNode" } }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_id", "room_id", "object_id", "template", "objective_ids", "instruction", "source_refs"],
      "properties": {
        "activity_id": { "type": "string", "pattern": "^ACT-[A-Z0-9-]+$" },
        "room_id": { "$ref": "#/$defs/nonEmptyId" },
        "object_id": { "$ref": "#/$defs/nonEmptyId" },
        "template": { "type": "string", "enum": ["observe", "operate", "investigate", "decide"] },
        "objective_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/objectiveId" } },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceReference" } },
        "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyId" } },
        "public_item_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyId" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "mission_id", "room_id", "object_id", "objective_ids", "title", "summary", "source_refs"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^EVD-[A-Z0-9-]+$" },
        "mission_id": { "$ref": "#/$defs/nonEmptyId" },
        "room_id": { "$ref": "#/$defs/nonEmptyId" },
        "object_id": { "$ref": "#/$defs/nonEmptyId" },
        "objective_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/objectiveId" } },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceReference" } }
      }
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hint_id", "activity_id", "level", "text"],
      "properties": {
        "hint_id": { "$ref": "#/$defs/nonEmptyId" },
        "activity_id": { "$ref": "#/$defs/nonEmptyId" },
        "level": { "type": "integer", "minimum": 1, "maximum": 5 },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" } }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedback_id", "activity_id", "path", "text"],
      "properties": {
        "feedback_id": { "$ref": "#/$defs/nonEmptyId" },
        "activity_id": { "$ref": "#/$defs/nonEmptyId" },
        "path": { "type": "string", "enum": ["needs_support", "developing", "ready_for_extension"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" } }
      }
    },
    "endings": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "needs_support": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "developing": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "ready_for_extension": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  }
}
