# SERVER ONLY. Nilai asli diset lewat `npx supabase secrets set`, bukan lewat Git.
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY disediakan otomatis oleh Supabase
# untuk Edge Functions yang di-deploy; jangan diset manual.

# student-api: WAJIB, minimal 32 byte. Set SEKALI; mengganti nilai ini membuat semua kode akses siswa lama tidak valid.
STUDENT_CREDENTIAL_HMAC_KEY=REPLACE_WITH_64_HEX_CHARS

# analysis-worker: WAJIB, minimal 32 karakter. Harus sama dengan secret Vault `b04_analysis_worker_secret`.
ANALYSIS_WORKER_SECRET=REPLACE_WITH_64_HEX_CHARS

# Provider AI untuk analysis-worker: gemini (default) atau openrouter.
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_IN_SECRETS
GEMINI_MODEL=REPLACE_IN_SECRETS
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# CORS: daftar origin persis, dipisah koma. Default hanya localhost; tambahkan domain Cloudflare Pages.
ALLOWED_ORIGINS=http://localhost:5173

# Route review/publish quest bersifat eksperimental. Biarkan false/kosong kecuali ada publish terkontrol
# di staging setelah gerbang keamanan di docs/B-13-RELEASE-RUNBOOK.md lulus.
B06_ENABLE_QUEST_DEMO_ROUTES=false

# CATATAN: AI_REQUESTS_PER_TEACHER_PER_DAY sebelumnya tercantum di sini, tetapi TIDAK dibaca kode mana pun
# di develop (kuota AI per guru belum diberlakukan). Lihat bagian "Gap terbuka" di runbook.
