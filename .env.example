# =====================================================
# apps/web/.env.example (PUBLIC — boleh masuk build)
# =====================================================
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
VITE_DATA_MODE=mock

# =====================================================
# Supabase Edge Function secrets (SERVER ONLY — jangan commit nilai asli)
# =====================================================
SUPABASE_SERVICE_ROLE_KEY=SET_IN_SECRET_MANAGER
GEMINI_API_KEY=SET_IN_SECRET_MANAGER
AI_REQUESTS_PER_TEACHER_PER_DAY=10
